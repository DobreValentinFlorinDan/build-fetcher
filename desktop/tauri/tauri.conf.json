{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Irelia Companion",
  "version": "2.2.0",
  "identifier": "com.ireliacompanion.app",
  "mainBinaryName": "IreliaCompanion",
  "build": {
    "frontendDist": "splash"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Irelia Companion",
    "copyright": "Not affiliated with Riot Games.",
    "category": "Utility",
    "shortDescription": "Irelia Companion",
    "longDescription": "Builds, drafts and an in-game overlay for League of Legends, from games fetched with your own Riot API key.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "resources": {
      "../../dist": "dist",
      "../../scrape.config.json": "scrape.config.json"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
