# Environment variables for development and tests (set them in your shell; no .env file is read). The app needs none.
# The Riot API key is never read from here: set it in the app (Settings → API key), where it is stored in
# %APPDATA%\build-fetcher\settings.json and shown only masked.

# PORT=5184                                   # the headless server's port (the desktop app picks its own)
# RIOT_RATE_LIMITS=20:1,100:120               # the key's limits until Riot's X-App-Rate-Limit header says otherwise
# RIOT_CONCURRENCY=3                          # requests in flight per host (1-3); never raises the rate
# LEAGUE_PATH=D:/Games/Riot Games/League of Legends

# Folders (tests and development):
# BF_CONFIG_DIR=C:/temp/bf-config             # settings.json and logs, instead of %APPDATA%\build-fetcher
# BF_DATA_DIR=D:/BuildFetcherData             # the data folder, instead of %APPDATA%\build-fetcher\data
# BF_IRELIA_CONFIG_DIR=C:/temp/irelia         # where to look for Irelia Companion's config.json (read only)
# BF_WEB_DIR=./dist                           # the built dashboard
# BF_FAKES=1                                  # sample data instead of the store and learner (dashboard work)
