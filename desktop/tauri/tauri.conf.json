{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Build Fetcher",
  "version": "1.3.4",
  "identifier": "com.buildfetcher.app",
  "mainBinaryName": "BuildFetcher",
  "build": {
    "frontendDist": "splash"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Build Fetcher",
    "copyright": "Build Fetcher isn't endorsed by Riot Games and doesn't reflect the views or opinions of Riot Games or anyone officially involved in producing or managing Riot Games properties.",
    "category": "Utility",
    "shortDescription": "Build Fetcher",
    "longDescription": "League of Legends builds for any champion and role, learned on this PC from games fetched with your own Riot API key.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "resources": {
      "../../dist": "dist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
