# Development keys expire every 24h - regenerate at https://developer.riotgames.com
RIOT_API_KEY=RGAPI-xxxxxxxx
PORT=5174

# Scrape scope lives in scrape.config.json (platforms, tiers, divisions, OTP threshold).
# These optional overrides win over the file:
# SCRAPE_PLATFORMS=KR,EUW1
# SCRAPE_TIERS=CHALLENGER,GRANDMASTER,MASTER

# Optional: production key limits "limit:seconds,limit:seconds"
# RIOT_RATE_LIMITS=20:1,100:120
# Optional: Riot requests in flight at once per host (1-3, default 3). Requests are paced either way,
# so this never raises the rate; it only hides network latency.
# RIOT_CONCURRENCY=3
# LEAGUE_PATH=D:/Games/Riot Games/League of Legends

# Desktop / storage (optional). Settings normally live in %APPDATA%\irelia-companion\config.json.
# IRELIA_DATA_DIR=D:/Games/IreliaData       # pin the data folder for this process (disables "Change data location")
# IRELIA_CONFIG_DIR=C:/temp/irelia-config   # use another settings folder (tests)
